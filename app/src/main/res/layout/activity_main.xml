<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0F17">

    <!-- 1. FULLSCREEN CAMERA VIEW (Like TikTok & Prism Live) -->
    <com.pedro.library.view.OpenGlView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible" />

    <!-- 2. TOP STATUS BAR (Overlay) -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#990B0E14"
        android:paddingHorizontal="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="10dp"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ONTIK Studio"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/liveTimerText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/bitrateText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="0 kbps"
                    android:textColor="#00E5FF"
                    android:textSize="12sp" />
            </LinearLayout>
        </RelativeLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Ready"
                android:textColor="#8E95AA"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/viewersCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="👥 Viewers: --"
                android:textColor="#FFB300"
                android:textSize="11sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- 3. CAMERA QUICK CONTROLS (Floating on Preview) -->
    <LinearLayout
        android:id="@+id/cameraControlsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/topBar"
        android:layout_alignParentEnd="true"
        android:layout_margin="12dp"
        android:orientation="vertical">

        <Button
            android:id="@+id/switchCameraBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_btn_mute"
            android:text="🔄"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/torchBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_btn_mute"
            android:text="⚡"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/zoomLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="1.0x"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

        <SeekBar
            android:id="@+id/zoomSeekBar"
            android:layout_width="100dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:max="40"
            android:progress="0"
            android:rotation="270"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 4. BOTTOM CONTROLS & SETTINGS (Semi-Transparent Overlay) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/bottomBar"
        android:layout_marginHorizontal="12dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:backgroundTint="#B3121520"
        android:maxHeight="320dp"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STREAM SETTINGS"
                android:textColor="#687390"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/platformSpinner"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input" />

            <Spinner
                android:id="@+id/modeSpinner"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input" />

            <Spinner
                android:id="@+id/ratioSpinner"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input" />

            <Spinner
                android:id="@+id/qualitySpinner"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <CheckBox
                    android:id="@+id/keepScreenOnCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Awake"
                    android:textColor="#CAD1E0"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/floatingWidgetCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Bubble"
                    android:textColor="#CAD1E0"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/noiseCancelCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Noise Filter"
                    android:textColor="#CAD1E0"
                    android:textSize="11sp" />

                <CheckBox
                    android:id="@+id/loopCheckbox"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loop"
                    android:textColor="#CAD1E0"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <EditText
                android:id="@+id/urlInput"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input"
                android:hint="RTMP URL"
                android:paddingHorizontal="10dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#5A627A"
                android:textSize="12sp" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="6dp">

                <EditText
                    android:id="@+id/keyInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:hint="Stream Key"
                    android:inputType="textPassword"
                    android:paddingHorizontal="10dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#5A627A"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/toggleKeyVisibilityBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="8dp"
                    android:text="SHOW"
                    android:textColor="#00E5FF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <Button
                android:id="@+id/youtubeBtn"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_btn_youtube"
                android:text="SIGN IN WITH YOUTUBE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/pickFileBtn"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_btn_mute"
                android:text="SELECT VIDEO FILE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <!-- 5. BOTTOM ACTION BAR (Start, Pause, Mute, Stop) -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#E60D0F17"
        android:paddingHorizontal="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/startBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.2"
            android:background="@drawable/bg_btn_start"
            android:text="START"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pauseBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_disabled"
            android:enabled="false"
            android:text="PAUSE"
            android:textColor="#888888"
            android:textSize="12sp" />

        <Button
            android:id="@+id/muteBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_disabled"
            android:enabled="false"
            android:text="MUTE"
            android:textColor="#888888"
            android:textSize="12sp" />

        <Button
            android:id="@+id/stopBtn"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_disabled"
            android:enabled="false"
            android:text="STOP"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>

</RelativeLayout>
